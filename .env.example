# Local API server
PORT=3001
NODE_ENV=development

# Comma-separated frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: only configure these if you have a legitimate, authorized proxy service
# PROXY_URL=
# FLARESOLVERR_URL=

# API rate limit per IP per 15 minutes
RATE_LIMIT_MAX=300
